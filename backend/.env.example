PORT=4000

# Local development uses SQLite automatically if DATABASE_URL is not set.
# For deployment, use a managed PostgreSQL database and set DATABASE_URL.
# DATABASE_URL=postgresql://username:password@host/database?sslmode=require
# DATABASE_SSL=true

# For deployment, set this to the exact frontend origin (no trailing slash),
# for example https://your-project.vercel.app
# FRONTEND_ORIGIN=http://localhost:5173

# Optional AI appointment summaries. Keep this key on the backend only.
# OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional custom OpenAI-compatible Chat Completions endpoint:
# OPENAI_API_BASE_URL=https://api.openai.com/v1/chat/completions

# Optional local SQLite path; ignored when DATABASE_URL is configured.
# SQLITE_PATH=../data/appointments.sqlite
